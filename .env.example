# Copy to .env; existing shell variables take precedence. Never commit .env.
MOCK=1
# Enable local inference with MOCK=0 once both trained files are available.
DETECTOR_FACTORY=agents.readiness.yolo:create_detector
READINESS_WEIGHTS=weights/readiness_yolo26m.pt
MATERIAL_MODEL_FACTORY=agents.material.yolo:create_predictor
MATERIAL_WEIGHTS=weights/material_yolo26m-cls.pt
GIGACHAT_ENABLED=0
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_CA_BUNDLE=
GIGACHAT_TIMEOUT_SECONDS=60
GIGACHAT_MAX_TOKENS=1200
GIGACHAT_AUTO_ANALYZE=1
