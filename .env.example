# Copy to .env; existing shell variables take precedence. Never commit .env.
MOCK=1
GIGACHAT_ENABLED=0
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_CA_BUNDLE=
GIGACHAT_TIMEOUT_SECONDS=60
GIGACHAT_MAX_TOKENS=1200
GIGACHAT_AUTO_ANALYZE=1
